# 复制为 .env 后按需修改（.env 已在 .gitignore 里）

# ---------- LLM 后端：ollama（本地，默认）| openai（任意 OpenAI 兼容服务） ----------
NL2SQL_LLM_BACKEND=ollama
NL2SQL_MODEL=qwen2.5:7b
NL2SQL_OLLAMA_BASE=http://127.0.0.1:11434
# 0=强制 CPU；-1=自动（有 GPU 就尽量上卡）
# 实测（RTX 3060 Laptop 6GB / 驱动 596.49 / Ollama 0.40.9）：7B 生成 7.7 → 26.4 tok/s，
# 端到端一问 90s → 31s；6GB 显存装不满 7B，实际 GPU 占比 79~84%，但已快 3 倍。
# 老驱动（如 546.30）与 Ollama 的 CUDA 内核不兼容会让 llama-server 崩，那种情况设 0；
# 后端里也有"GPU 失败自动降级 CPU"的兜底。
NL2SQL_OLLAMA_NUM_GPU=-1
NL2SQL_OLLAMA_NUM_CTX=8192

# ---------- 云端后端（NL2SQL_LLM_BACKEND=openai 时生效） ----------
# OPENAI_API_KEY=sk-xxx
# NL2SQL_OPENAI_BASE=https://api.openai.com/v1
# NL2SQL_OPENAI_MODEL=gpt-4o-mini
# 走 DeepSeek：NL2SQL_OPENAI_BASE=https://api.deepseek.com/v1  NL2SQL_OPENAI_MODEL=deepseek-flash

# ---------- Schema Linking 向量召回（可选增强） ----------
# 留空 = 关闭，只用 BM25 + 字面值命中 + LLM 重排（README 里那份 EX 61.2% 就是这个配置）。
# 填模型名即启用：本机 `ollama pull bge-m3`（1024 维，中文强项）。实测把同义词/口语类问题的
# 表召回从 8/10 提到 10/10（「售后赔付」-> refund、「哪类东西最贵」-> product/category）。
# 注意：embedding 也走 Ollama，所以 NL2SQL_OLLAMA_NUM_GPU 同样作用于它。
#      早先驱动不兼容时 embedding 会让 llama-server 崩，当时必须设 0；
#      驱动升级到 596.49 后已实测 GPU embedding 正常（1024 维）。
NL2SQL_EMBED_MODEL=
# NL2SQL_EMBED_CACHE=data/embed_cache      # 向量磁盘缓存目录（按 模型+文本 哈希，第二次 0 成本）

# ---------- Agent 行为（也是消融实验的开关） ----------
NL2SQL_N_CANDIDATES=3          # 自一致性候选数；1 = 关掉投票
NL2SQL_MAX_REPAIR_ROUNDS=2     # 执行自愈轮数上限；0 = 关掉自愈
NL2SQL_TOP_K_TABLES=6          # Schema Linking 保留的表数
NL2SQL_CONFIDENCE_THRESHOLD=0.55

# ---------- 数据库与安全 ----------
NL2SQL_DB=data/nl2sql.db
NL2SQL_QUERY_TIMEOUT=10
NL2SQL_MAX_ROWS=500
NL2SQL_DEFAULT_LIMIT=100

# ---------- Trace ----------
NL2SQL_TRACE=true
NL2SQL_TRACE_DIR=traces
# 是否把模型的原始请求/响应也写进 trace（默认 false；排查坏样本时再开，文件会明显变大）
NL2SQL_TRACE_LLM=false

# ---------- 记忆 ----------
# local = 会话写 data/sessions/*.json、偏好写 data/memory.db（默认，不需要额外服务）
# redis = 两边都走 Redis（需先 pip install redis，并起一个 Redis 服务）
NL2SQL_MEMORY_BACKEND=local
NL2SQL_REDIS_URL=redis://127.0.0.1:6379/0
NL2SQL_SESSION_TTL=604800        # Redis 下会话记忆的过期时间（秒，默认 7 天）
